  "analysis_code_sha256": "4f96c6a3b6b26f69497030cee4017a86d208f8a8f8a5750d3aeef3c5cb1d5614",
  "definitions": {
    "gap": "Current actual inner-forward logp minus saved historical rollout logq; p0/reference variants separated.",
    "aggregation": "Sum microbatch/rank sufficient statistics before any mean/RMS; actual global gradient norm and Adam delta counted once.",
    "L2": "sqrt(sum squared gap), length dependent; RMS normalizes by actual valid token count.",
    "tail": "Strict abs gap >0.5; conditional mean/excess zero when no tail tokens; unavailable population means remain null.",
    "coefficient": "Actual dL/dlogp from the ordinary backward divided by native DP factor; not parameter-gradient sign decomposition.",
    "Adam_round_path": "Sum of four update displacement norms, not norm of net 600-to-current parameter change.",
    "populations": "Accepted training, new all-completed responses, and fresh validation remain separate tables/plots.",
    "PPL": "exp(token-weighted mean NLL), not mean(exp(token NLL)); overflow is null plus explicit flag.",
    "first_word": "Observed first visible word frequency, not first-token model probability.",
    "native_counters": "pilot44 attempt/token/client-second totals include pre600 history. Deltas require consecutive observed rounds; first or reset deltas are null. Client seconds sum concurrent requests and are not generation wall time.",
    "performance": "Native timing/throughput labels preserved. CPU text assessment is contained in actor-update wall time; do not add them. Testing/save/step timers may overlap; no artificial summed total is reported.",
    "native_staleness": "Audited native APRIL uses version=global_steps-1, stale iff a selected token segment policy_version<version, max_age=version-policy_version. Multi-version response iff its nonempty segments contain >1 version; an entirely old single-version response may be stale without crossing weights. Missing sync counters remain null, never assumed zero. Completion-round age and later selected-training age refer to different populations/times.",
    "uncertainty": "Endpoint CI bootstraps paired questions conditional on one training trajectory; seven unadjusted baseline comparisons."
  },
  "limitations": [
    "A single asynchronously sampled trajectory per arm cannot establish seed-robust causal effects.",
    "Primary64x8 validation pairs question IDs, not sampled responses: native full_determinism=false has replica-level engine seeds and no explicit qid-by-replicate request seeds. Secondary128x4 explicit-job-seed evaluation is a separate population.",
    "Method7 changes the collection protocol, acceptance and throughput as well as response staleness.",
    "No all-completed repeat/gap values are copied from accepted data; missing postprocessing is explicit.",
    "No repeated tokens or direct-coefficient mass are called parameter gradient contributions."
  ],
